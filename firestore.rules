rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼ Put your two Google (Gmail) addresses here, in lowercase.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'charlene.example@gmail.com',
          'woojung.example@gmail.com'
        ];
    }

    match /entries/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
        && request.resource.data.type in ['spending', 'income']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.name in ['Woojung', 'Charlene']
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 200;
    }

    match /people/{name} {
      allow read: if allowed();
      allow create: if allowed()
        && name in ['Woojung', 'Charlene']
        && request.resource.data.uid == request.auth.uid;
    }
  }
}
